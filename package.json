{
  "name": "kadro",
  "productName": "Kadro",
  "version": "0.3.0",
  "description": "Kadro — free open-source video editor",
  "license": "MIT",
  "author": "Kadro contributors",
  "homepage": "https://kadro.studio",
  "repository": "github:kadro-studio/kadro",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "smoke": "node scripts/smoke.mjs",
    "dist": "node scripts/font-notices.mjs && npm run build && node scripts/make-icon.mjs && electron-builder --win --publish never",
    "icon": "node scripts/make-icon.mjs",
    "art": "node scripts/make-installer-art.mjs",
    "workshop:zip": "node scripts/pack-workshop.mjs"
  },
  "build": {
    "appId": "org.kadro.editor",
    "productName": "Kadro",
    "copyright": "Copyright © 2026 Kadro contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json",
      "!dist/**/*.map",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "extraResources": [
      {
        "from": "mods",
        "to": "mods",
        "filter": [
          "*.vrmod"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "fileAssociations": [
      {
        "ext": "vrproj",
        "name": "Kadro project",
        "description": "Kadro video project",
        "icon": "build/icon.ico"
      },
      {
        "ext": "kadroitem",
        "name": "Kadro workshop item",
        "description": "Kadro filter, title style, theme or template",
        "icon": "build/icon.ico"
      },
      {
        "ext": "vrmod",
        "name": "Kadro mod",
        "description": "Kadro effect, transition or element",
        "icon": "build/icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "Kadro"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kadro",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "Kadro-Setup-${version}.exe",
      "license": "LICENSE",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "uk_UA",
        "ru_RU",
        "en_US"
      ],
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "Kadro-${version}-portable.exe",
      "splashImage": "build/splash.bmp"
    },
    "protocols": [
      {
        "name": "Kadro",
        "schemes": [
          "kadro"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "kadro-studio",
        "repo": "kadro",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/comfortaa": "^5.3.0",
    "@fontsource-variable/exo-2": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/raleway": "^5.3.0",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/amatic-sc": "^5.3.0",
    "@fontsource/bad-script": "^5.3.0",
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/marck-script": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/rubik-mono-one": "^5.3.0",
    "@fontsource/ruslan-display": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "immer": "^11.2.7",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "zustand": "^5.0.15"
  }
}
