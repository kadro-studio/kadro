{
  "format": 1,
  "id": "kadro.shake-cut",
  "kind": "transition",
  "name": "Shake cut",
  "nameRu": "Тряска",
  "nameUk": "Струс",
  "author": "Kadro",
  "version": "1.0.0",
  "description": "A hard hit on the cut: shake, zoom and colour split.",
  "descriptionRu": "Жёсткий удар на склейке: тряска, наезд и разлёт цветов.",
  "descriptionUk": "Різкий удар на склейці: струс, наїзд і розліт кольорів.",
  "tags": [
    "trend"
  ],
  "params": [
    {
      "id": "amount",
      "name": "Strength",
      "nameRu": "Сила",
      "nameUk": "Сила",
      "min": 0,
      "max": 1,
      "default": 0.7,
      "step": 0.01
    }
  ],
  "glsl": "vec4 shakeSample(vec2 q, bool next) {\n  return next ? toColor(clamp(q, 0.0, 1.0)) : fromColor(clamp(q, 0.0, 1.0));\n}\nvec4 transition(vec2 uv) {\n  float hit = exp(-abs(progress - 0.5) * 9.0);\n  float t = floor(progress * 40.0);\n  vec2 j = (vec2(rand(vec2(t, 1.0)), rand(vec2(t, 2.0))) - 0.5) * 0.08 * amount * hit;\n  vec2 q = (uv - 0.5) / (1.0 + 0.15 * amount * hit) + 0.5 + j;\n  vec2 off = vec2(0.02 * amount * hit, 0.0);\n  bool next = progress >= 0.5;\n  vec4 c = shakeSample(q, next);\n  vec4 col = vec4(shakeSample(q + off, next).r, c.g, shakeSample(q - off, next).b, c.a);\n  col.rgb += hit * 0.25 * amount;\n  return col;\n}"
}
