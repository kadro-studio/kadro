{
  "format": 1,
  "id": "kadro.stripe-slide",
  "kind": "transition",
  "name": "Stripe slide",
  "nameRu": "Полосы",
  "nameUk": "Смуги",
  "author": "Kadro",
  "version": "1.0.0",
  "description": "Stripes slide away in alternating directions.",
  "descriptionRu": "Полосы разъезжаются в разные стороны.",
  "descriptionUk": "Смуги роз’їжджаються в різні боки.",
  "tags": [
    "trend"
  ],
  "params": [
    {
      "id": "count",
      "name": "Stripes",
      "nameRu": "Полосы",
      "nameUk": "Смуги",
      "min": 2,
      "max": 24,
      "default": 8,
      "step": 1
    },
    {
      "id": "stagger",
      "name": "Stagger",
      "nameRu": "Разброс",
      "nameUk": "Розкид",
      "min": 0,
      "max": 0.6,
      "default": 0.25,
      "step": 0.01
    }
  ],
  "glsl": "float easeInOut(float t) { return t < 0.5 ? 4.0 * t * t * t : 1.0 - pow(-2.0 * t + 2.0, 3.0) / 2.0; }\nvec4 transition(vec2 uv) {\n  float n = floor(count + 0.5);\n  float row = floor(uv.y * n);\n  float side = mod(row, 2.0) < 1.0 ? 1.0 : -1.0;\n  float delay = rand(vec2(row, 3.7)) * stagger;\n  float t = clamp((progress - delay) / max(0.001, 1.0 - stagger), 0.0, 1.0);\n  float x = uv.x + side * easeInOut(t);\n  if (x >= 0.0 && x <= 1.0) return fromColor(vec2(x, uv.y));\n  return toColor(vec2(x - side, uv.y));\n}"
}
