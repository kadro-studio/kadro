{
  "format": 1,
  "id": "kadro.crt-monitor",
  "kind": "effect",
  "name": "CRT monitor",
  "nameRu": "Кинескоп",
  "author": "Kadro",
  "version": "1.0.0",
  "description": "Curved glass, scanlines, RGB mask and rolling brightness of an old monitor.",
  "params": [
    {
      "id": "curve",
      "name": "Curvature",
      "nameRu": "Изгиб",
      "min": 0,
      "max": 0.5,
      "default": 0.18,
      "nameUk": "Вигин"
    },
    {
      "id": "lines",
      "name": "Scanlines",
      "nameRu": "Строки",
      "min": 0,
      "max": 1,
      "default": 0.5,
      "nameUk": "Рядки"
    }
  ],
  "glsl": "vec4 effect(vec2 uv) {\n  vec2 q = uv * 2.0 - 1.0;\n  q *= 1.0 + curve * dot(q, q) * 0.25;\n  vec2 p = q * 0.5 + 0.5;\n  if (p.x < 0.0 || p.x > 1.0 || p.y < 0.0 || p.y > 1.0) return vec4(0.0, 0.0, 0.0, 1.0);\n  vec4 c = src(p);\n  float scan = 0.5 + 0.5 * sin(p.y * u_size.y * PI);\n  c.rgb *= 1.0 - lines * 0.35 * scan;\n  float m = mod(floor(p.x * u_size.x), 3.0);\n  vec3 mask = m < 1.0 ? vec3(1.0, 0.8, 0.8) : (m < 2.0 ? vec3(0.8, 1.0, 0.8) : vec3(0.8, 0.8, 1.0));\n  c.rgb *= mix(vec3(1.0), mask, lines);\n  c.rgb *= 0.95 + 0.05 * sin(p.y * 6.0 - u_time * 4.0);\n  c.rgb *= 1.0 - 0.5 * smoothstep(0.6, 1.4, length(q));\n  return c;\n}",
  "nameUk": "Кінескоп"
}
