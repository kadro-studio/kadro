{
  "format": 1,
  "id": "kadro.spiral-wipe",
  "kind": "transition",
  "name": "Spiral wipe",
  "nameRu": "Спираль",
  "author": "Kadro",
  "version": "1.0.0",
  "description": "The next clip unwinds from the centre along a spiral.",
  "params": [
    { "id": "arms", "name": "Arms", "nameRu": "Витки", "min": 1, "max": 8, "default": 3, "step": 1 }
  ],
  "glsl": "vec4 transition(vec2 uv) {\n  vec2 q = (uv - 0.5) * vec2(ratio, 1.0);\n  float a = atan(q.y, q.x) / (2.0 * PI) + 0.5;\n  float r = length(q) / length(vec2(ratio, 1.0) * 0.5);\n  float v = fract(a + r * floor(arms)) * 0.5 + r * 0.5;\n  float edge = progress * 1.1;\n  return mix(toColor(uv), fromColor(uv), smoothstep(edge - 0.05, edge, v));\n}"
}
