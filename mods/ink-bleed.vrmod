{
  "format": 1,
  "id": "kadro.ink-bleed",
  "kind": "transition",
  "name": "Ink bleed",
  "nameRu": "Чернила",
  "author": "Kadro",
  "version": "1.0.0",
  "description": "The next clip spreads like ink soaking into paper.",
  "params": [
    { "id": "softness", "name": "Softness", "nameRu": "Мягкость", "min": 0.01, "max": 0.3, "default": 0.08 }
  ],
  "glsl": "float noise(vec2 p) {\n  vec2 i = floor(p);\n  vec2 f = fract(p);\n  vec2 s = f * f * (3.0 - 2.0 * f);\n  return mix(mix(rand(i), rand(i + vec2(1.0, 0.0)), s.x), mix(rand(i + vec2(0.0, 1.0)), rand(i + vec2(1.0, 1.0)), s.x), s.y);\n}\nvec4 transition(vec2 uv) {\n  vec2 p = uv * vec2(ratio, 1.0) * 4.0;\n  float n = noise(p) * 0.5 + noise(p * 2.0) * 0.25 + noise(p * 4.0) * 0.125;\n  n = n / 0.875 * 0.7 + (1.0 - length(uv - 0.5) * 1.2) * 0.3;\n  float edge = 1.0 - progress * (1.0 + softness * 2.0) + softness;\n  return mix(fromColor(uv), toColor(uv), smoothstep(edge - softness, edge + softness, n));\n}"
}
