{
  "format": 1,
  "id": "kadro.shine",
  "kind": "effect",
  "name": "Shine sweep",
  "nameRu": "Блик",
  "nameUk": "Відблиск",
  "author": "Kadro",
  "version": "1.0.0",
  "description": "A band of light runs across the frame.",
  "descriptionRu": "По кадру пробегает полоса света.",
  "descriptionUk": "Кадром пробігає смуга світла.",
  "tags": [
    "trend"
  ],
  "params": [
    {
      "id": "speed",
      "name": "Speed",
      "nameRu": "Скорость",
      "nameUk": "Швидкість",
      "min": 0.1,
      "max": 3,
      "default": 0.6,
      "step": 0.01
    },
    {
      "id": "width",
      "name": "Width",
      "nameRu": "Ширина",
      "nameUk": "Ширина",
      "min": 0.02,
      "max": 0.4,
      "default": 0.12,
      "step": 0.01
    },
    {
      "id": "intensity",
      "name": "Brightness",
      "nameRu": "Яркость",
      "nameUk": "Яскравість",
      "min": 0,
      "max": 1.5,
      "default": 0.6,
      "step": 0.01
    },
    {
      "id": "angle",
      "name": "Angle",
      "nameRu": "Угол",
      "nameUk": "Кут",
      "min": 0,
      "max": 180,
      "default": 30,
      "step": 1
    }
  ],
  "glsl": "vec4 effect(vec2 uv) {\n  vec4 c = src(uv);\n  float a = radians(angle);\n  vec2 dir = vec2(cos(a), sin(a));\n  vec2 q = (uv - 0.5) * vec2(u_size.x / u_size.y, 1.0);\n  float d = dot(q, dir);\n  float pos = fract(u_time * speed) * 3.0 - 1.5;\n  float band = exp(-pow((d - pos) / max(0.001, width), 2.0));\n  c.rgb += band * intensity * (0.6 + 0.4 * c.rgb) * c.a;\n  return c;\n}"
}
