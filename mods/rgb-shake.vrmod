{
  "format": 1,
  "id": "kadro.rgb-shake",
  "kind": "effect",
  "name": "RGB shake",
  "nameRu": "Дрожь RGB",
  "nameUk": "Тремтіння RGB",
  "author": "Kadro",
  "version": "1.0.0",
  "description": "Shake and a colour split on every beat.",
  "descriptionRu": "Тряска и разлёт цветов на каждый бит.",
  "descriptionUk": "Струс і розліт кольорів на кожен біт.",
  "tags": [
    "trend"
  ],
  "params": [
    {
      "id": "bpm",
      "name": "Tempo (BPM)",
      "nameRu": "Темп (BPM)",
      "nameUk": "Темп (BPM)",
      "min": 40,
      "max": 220,
      "default": 120,
      "step": 1
    },
    {
      "id": "amount",
      "name": "Strength",
      "nameRu": "Сила",
      "nameUk": "Сила",
      "min": 0,
      "max": 1,
      "default": 0.6,
      "step": 0.01
    }
  ],
  "glsl": "vec4 effect(vec2 uv) {\n  float beat = fract(u_time * bpm / 60.0);\n  float hit = exp(-beat * 7.0);\n  float t = floor(u_time * 24.0);\n  vec2 jitter = (vec2(rand(vec2(t, 1.0)), rand(vec2(t, 2.0))) - 0.5) * 0.05 * amount * hit;\n  vec2 q = uv + jitter;\n  vec2 off = vec2(0.014, 0.0) * amount * hit;\n  vec4 c = src(q);\n  return vec4(src(q + off).r, c.g, src(q - off).b, c.a);\n}"
}
